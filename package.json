{
  "name": "social-wrapped",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crates/wasm --target web --out-dir ../../src/wasm-pkg",
    "build:wasm:dev": "wasm-pack build crates/wasm --target web --out-dir ../../src/wasm-pkg --dev",
    "dev": "vite",
    "dev:app": "vite",
    "build": "bun run build:wasm && tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:dev": "tauri android dev",
    "android:dev:device": "tauri android dev --host",
    "android:build": "tauri android build --apk"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@remotion/cli": "4.0.503",
    "@remotion/google-fonts": "^4.0.503",
    "@remotion/player": "4.0.503",
    "@remotion/transitions": "^4.0.503",
    "@remotion/web-renderer": "4.0.503",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.27.0",
    "media-chrome": "^4.19.2",
    "motion": "^12.43.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.3.0",
    "remotion": "4.0.503",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-wasm": "^3.5.0"
  }
}
